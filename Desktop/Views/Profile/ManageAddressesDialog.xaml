<Window x:Class="PizzariaDesktop.Views.Profile.ManageAddressesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzariaDesktop.Views.Profile"
        mc:Ignorable="d"
        Title="Gerenciar Endereços"
        Height="650" Width="500"
        MinHeight="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Colors - Matching OrderConfirmationDialog palette -->
        <Color x:Key="PrimaryColor">#FF6B35</Color>
        <Color x:Key="PrimaryVariantColor">#E85D2E</Color>
        <Color x:Key="SuccessColor">#28A745</Color>
        <Color x:Key="SuccessLightColor">#E8F5E9</Color>
        <Color x:Key="ErrorColor">#DC3545</Color>
        <Color x:Key="ErrorLightColor">#FDEDEC</Color>
        <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="SurfaceColor">#FFF8F9FA</Color>
        <Color x:Key="TextPrimaryColor">#FF1A1A2E</Color>
        <Color x:Key="TextSecondaryColor">#FF6C757D</Color>
        <Color x:Key="BorderColor">#FFE9ECEF</Color>
        <Color x:Key="DividerColor">#FFDEE2E6</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

        <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>

        <!-- Typography Styles -->
        <Style x:Key="DisplayStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="40" />
        </Style>

        <Style x:Key="HeadlineStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!-- Primary Button - Main Action -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                                Effect="{StaticResource ButtonShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryVariantBrush}" />
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource PrimaryColor}" ShadowDepth="0" BlurRadius="16" Opacity="0.4" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D44E1F" />
                                <Setter TargetName="Border" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FFA890" />
                                <Setter TargetName="Border" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button - Alternative Action -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="28,14" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFF0EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFE0D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD0C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button - Minimal Action (Close button) -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (Delete) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFDEDEC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFADBD8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Effects -->
        <DropShadowEffect x:Key="ButtonShadowEffect" Color="{StaticResource PrimaryColor}" ShadowDepth="0" BlurRadius="12" Opacity="0.3" />
        <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" ShadowDepth="0" BlurRadius="24" Opacity="0.12" />

        <!-- Address Item Template -->
        <DataTemplate x:Key="AddressItemTemplate">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18,16" Margin="0,0,0,12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    x:Name="AddressCard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Address Icon with Label Color -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Background="#FFFFF0EB" Margin="0,0,14,0">
                        <Grid>
                            <TextBlock Text="🏠" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="DefaultBadge" Width="20" Height="20" CornerRadius="10"
                                    Background="{StaticResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-6,-6" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Address Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="(Padrão)" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Text="{Binding FullAddress}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="280" />
                    </StackPanel>

                    <!-- Edit Button -->
                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="✏️" FontSize="16"
                            Width="40" Height="40" Padding="0" Margin="0,0,8,0"
                            ToolTip="Editar" Click="EditAddress_Click" Tag="{Binding}" />

                    <!-- Delete Button -->
                    <Button Grid.Column="3" Style="{StaticResource DangerButtonStyle}" Content="🗑" FontSize="14"
                            Width="40" Height="40" Padding="0"
                            ToolTip="Excluir" Click="DeleteAddress_Click" Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Empty State Template -->
        <DataTemplate x:Key="EmptyAddressTemplate">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="40,32" Margin="0,20,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#FFFFF0EB" Margin="0,0,16,0">
                        <TextBlock Text="📍" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nenhum endereço cadastrado" Style="{StaticResource TitleStyle}" FontSize="16" />
                        <TextBlock Text="Adicione seu primeiro endereço para agilizar seus pedidos" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="240" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Fade in + Scale animation for main card -->
                    <DoubleAnimation Storyboard.TargetName="MainCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"
                                     BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainCardTransform"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.92" To="1" Duration="0:0:0.45"
                                     BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainCardTransform"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.92" To="1" Duration="0:0:0.45"
                                     BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Content stagger animation -->
                    <DoubleAnimation Storyboard.TargetName="ContentStack"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4"
                                     BeginTime="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ContentStack"
                                     Storyboard.TargetProperty="RenderTransform.Children[0].Y"
                                     From="20" To="0" Duration="0:0:0.5"
                                     BeginTime="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Main Card with Shadow -->
        <Border x:Name="MainCard" Background="Transparent" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource CardShadowEffect}" Opacity="0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="MainCardTransform" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <Border CornerRadius="20" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Header -->
                        <RowDefinition Height="*" />     <!-- Scrollable Content -->
                        <RowDefinition Height="Auto" />  <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- ==================== HEADER ==================== -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="32,36" CornerRadius="19,19,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📍 Gerenciar Endereços" Style="{StaticResource HeadlineStyle}" Foreground="White" FontSize="26" />
                                <TextBlock Text="Cadastre e gerencie seus endereços de entrega" Style="{StaticResource SubtitleStyle}" Foreground="#FFFFE0D8" FontSize="15" Margin="0,8,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="✕" FontSize="20" FontWeight="Bold"
                                    Width="44" Height="44" Padding="0" Click="CloseButton_Click" ToolTip="Fechar" />
                        </Grid>
                    </Border>

                    <!-- ==================== SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,28"
                                  BorderThickness="0" Background="Transparent">
                        <StackPanel x:Name="ContentStack" Orientation="Vertical">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </StackPanel.RenderTransform>

                            <!-- Addresses List -->
                            <ItemsControl x:Name="AddressesList" ItemTemplate="{StaticResource AddressItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Empty State (shown when no addresses) -->
                            <ContentControl x:Name="EmptyState" ContentTemplate="{StaticResource EmptyAddressTemplate}" Visibility="Collapsed" />

                            <!-- Add New Address Form (initially hidden) -->
                            <Border x:Name="AddAddressForm" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24" Margin="0,20,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadowEffect}" Visibility="Collapsed">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="➕ Novo Endereço" Style="{StaticResource TitleStyle}" FontSize="18" Margin="0,0,0,20" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                                            <TextBlock Text="Rótulo (ex: Casa, Trabalho)" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                            <TextBox x:Name="LabelTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="Casa" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                                            <TextBlock Text="Número" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                            <TextBox x:Name="NumberTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="123" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Rua / Avenida" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                        <TextBox x:Name="StreetTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="Rua das Flores" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Complemento (opcional)" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                        <TextBox x:Name="ComplementTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="Apto 45, Bloco B" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                                            <TextBlock Text="Bairro" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                            <TextBox x:Name="NeighborhoodTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="Jardim Primavera" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                                            <TextBlock Text="CEP" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                            <TextBox x:Name="ZipCodeTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="01234-567" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                                            <TextBlock Text="Cidade" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                            <TextBox x:Name="CityTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="São Paulo" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                                            <TextBlock Text="Estado" Style="{StaticResource BodyStyle}" FontWeight="Medium" FontSize="14" Margin="0,0,0,6" />
                                            <TextBox x:Name="StateTextBox" Style="{StaticResource InputStyle}" Height="50" Tag="SP" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="IsDefaultCheckBox" Content="Definir como endereço padrão" FontSize="14" Margin="0,6,0,20" VerticalContentAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontFamily}">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="CheckBorder" Width="22" Height="22" CornerRadius="4"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                                                            Background="{StaticResource BackgroundBrush}" Margin="0,0,10,0">
                                                        <Path x:Name="CheckMark" Data="M0,0 L1,1 M1,0 L0,1" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.5" Margin="4,3,4,3" Visibility="Collapsed" />
                                                    </Border>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CancelAddButton" Style="{StaticResource SecondaryButtonStyle}"
                                                Height="44" Margin="0,0,12,0" Click="CancelAddButton_Click" Padding="20,10">
                                            <TextBlock Text="Cancelar" VerticalAlignment="Center" FontWeight="Medium" />
                                        </Button>
                                        <Button x:Name="SaveAddressButton" Style="{StaticResource PrimaryButtonStyle}"
                                                Height="44" Click="SaveAddressButton_Click" Padding="24,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Salvar Endereço" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== ACTION BUTTONS ==================== -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="24,20,24,28" CornerRadius="0,0,19,19"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Vertical" Margin="0">
                            <!-- Add Address Button -->
                            <Button x:Name="AddAddressButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="56" Click="AddAddressButton_Click" Visibility="Visible">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Adicionar Endereço" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Close Button -->
                            <Button x:Name="CloseButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="52" Margin="0,12,0,0" Click="CloseButton_Click">
