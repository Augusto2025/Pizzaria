<UserControl x:Class="PizzariaDesktop.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PizzariaDesktop.Views.Auth"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE - Primary Color Brand Panel (Full Height) -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" Padding="80,100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Brand -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,60">
                    <TextBlock Text="🍕" FontSize="96" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <TextBlock Text="Pizzaria Delivery" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Sistema de Pedidos Online" FontSize="20" Foreground="#FFFFE0D8" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <!-- Welcome Message -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            TextBlock.Foreground="White" TextBlock.TextAlignment="Center" Margin="80,0">
                    <TextBlock Text="Bem-vindo de volta!" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,24" />
                    <TextBlock Text="Faça seu login para acessar o cardápio,&#x0a;acompanhar pedidos e gerenciar seu perfil."
                               FontSize="20" Foreground="#FFFFE0D8" LineHeight="32" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Features List -->
                <StackPanel Grid.Row="2" Margin="80,60,80,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="🍕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Cardápio completo com fotos" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Entrega rápida na sua porta" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="💳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pagamento seguro e flexível" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="📱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Acompanhamento em tempo real" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT SIDE - Login Form Panel (Full Height, Centered Content) -->
        <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" Padding="80,60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Centered Form Container - No ScrollViewer, fits naturally -->
                <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <StackPanel Width="380">
                        <!-- Header -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Entrar na sua conta" Style="{StaticResource HeadlineStyle}" FontSize="32" />
                            <TextBlock Text="Preencha seus dados para continuar" Style="{StaticResource SubtitleStyle}" Margin="0,8,0,0" FontSize="15" />
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,28" />

                        <!-- Email Field -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="E-mail" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,8" FontSize="14" />
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Tag="seu@email.com" Padding="10,1" FontSize="15" Height="52" />
                        </StackPanel>

                        <!-- Password Field with Show/Hide Toggle -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Senha" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,8" FontSize="14" />
                            <Grid Height="52">
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource PasswordBoxStyle}"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             Tag="••••••••"
                                             FontSize="15"
                                             Padding="12,0,48,0"
                                             VerticalContentAlignment="Center" />
                                <TextBox x:Name="PasswordTextBox"
                                         Style="{StaticResource InputStyle}"
                                         TextChanged="PasswordTextBox_TextChanged"
                                         Tag="••••••••"
                                         FontSize="15"
                                         Padding="12,0,48,0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed" />
                                <Button x:Name="TogglePasswordButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="44" Height="44"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        Click="TogglePasswordButton_Click"
                                        ToolTip="Mostrar/ocultar senha">
                                    <TextBlock x:Name="EyeIcon" Text="👁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Margin="0,0,0,18"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=empty}" />

                        <!-- Login Button -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Entrar"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Height="52"
                                FontSize="15"
                                FontWeight="Medium"
                                Margin="0,0,0,14" />

                        <!-- Loading Indicator -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,18">
                            <Border Width="24" Height="24" BorderBrush="White" BorderThickness="2" CornerRadius="12"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotation" Angle="0" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1"
                                                                 RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <TextBlock Text="Entrando..." Style="{StaticResource BodyStyle}" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>

                        <!-- Demo Info -->
                        <Border Background="#FFFEF3E2" BorderBrush="#FFFFD8B8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,24">
                            <StackPanel>
                                <TextBlock Text="💡 Modo Demo" FontWeight="Medium" Foreground="#FF8B5E00" FontSize="12" />
                                <TextBlock Text="Qualquer e-mail e senha funcionam para teste." FontSize="11" Foreground="#FF8B5E00" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Register Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Não tem conta? " Style="{StaticResource BodyStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                            <Button Content="Cadastre-se" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,4" BorderThickness="0" Background="Transparent" FontSize="14"
                                    Command="{Binding GoToRegisterCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Version/Footer -->
                <TextBlock Grid.Row="2" Text="v1.0.0 • Modo Demonstração"
                           Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,24,0,0" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</UserControl>