<UserControl x:Class="PizzariaDesktop.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PizzariaDesktop.Views.Auth"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE - Primary Color Brand Panel (Full Height) -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" Padding="80,100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Brand -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,60">
                    <TextBlock Text="🍕" FontSize="96" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <TextBlock Text="Pizzaria Delivery" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Sistema de Pedidos Online" FontSize="20" Foreground="#FFFFE0D8" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <!-- Welcome Message -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            TextBlock.Foreground="White" TextBlock.TextAlignment="Center" Margin="80,0">
                    <TextBlock Text="Crie sua conta!" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,24" />
                    <TextBlock Text="Cadastre-se para acessar o cardápio,&#x0a;fazer pedidos e acompanhar entregas."
                               FontSize="20" Foreground="#FFFFE0D8" LineHeight="32" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Benefits List -->
                <StackPanel Grid.Row="2" Margin="80,60,80,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="🍕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Cardápio completo com fotos" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Entrega rápida na sua porta" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="💳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pagamento seguro e flexível" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF">
                            <TextBlock Text="📱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Acompanhamento em tempo real" FontSize="18" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT SIDE - Register Form Panel (Full Height, Centered Content) -->
        <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" Padding="60,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Centered Form Container - No ScrollViewer, fits naturally -->
                <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <StackPanel Width="360">
                        <!-- Header -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Criar conta" Style="{StaticResource HeadlineStyle}" FontSize="28" />
                            <TextBlock Text="Preencha seus dados para começar" Style="{StaticResource SubtitleStyle}" Margin="0,6,0,0" FontSize="14" />
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,20" />

                        <!-- Name Field -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Nome completo" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" FontSize="13" />
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Tag="João da Silva" Padding="10,1" FontSize="14" Height="48" />
                            <TextBlock Text="Nome é obrigatório"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Email Field -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="E-mail" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" FontSize="13" />
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Tag="seu@email.com" Padding="10,1" FontSize="14" Height="48" />
                            <TextBlock Text="E-mail é obrigatório"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Phone Field -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Telefone" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" FontSize="13" />
                            <TextBox x:Name="PhoneTextBox"
                                     Style="{StaticResource InputStyle}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Tag="(11) 99999-9999" Padding="10,1" FontSize="14" Height="48"
                                     PreviewTextInput="PhoneTextBox_PreviewTextInput"
                                     TextChanged="PhoneTextBox_TextChanged" />
                            <TextBlock Text="Telefone é obrigatório"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasPhoneError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Password Field with Show/Hide Toggle -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Senha" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" FontSize="13" />
                            <Grid Height="48">
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource PasswordBoxStyle}"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             Tag="••••••••"
                                             FontSize="14"
                                             Padding="12,0,48,0"
                                             VerticalContentAlignment="Center" />
                                <TextBox x:Name="PasswordTextBox"
                                         Style="{StaticResource InputStyle}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         TextChanged="PasswordTextBox_TextChanged"
                                         Tag="••••••••"
                                         FontSize="14"
                                         Padding="12,0,48,0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed" />
                                <Button x:Name="TogglePasswordButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="40" Height="40"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        Click="TogglePasswordButton_Click"
                                        ToolTip="Mostrar/ocultar senha">
                                    <TextBlock x:Name="EyeIcon" Text="👁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Senha deve ter pelo menos 6 caracteres"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Confirm Password Field with Show/Hide Toggle -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Confirmar senha" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" FontSize="13" />
                            <Grid Height="48">
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Style="{StaticResource PasswordBoxStyle}"
                                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                             Tag="••••••••"
                                             FontSize="14"
                                             Padding="12,0,48,0"
                                             VerticalContentAlignment="Center" />
                                <TextBox x:Name="ConfirmPasswordTextBox"
                                         Style="{StaticResource InputStyle}"
                                         Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         TextChanged="ConfirmPasswordTextBox_TextChanged"
                                         Tag="••••••••"
                                         FontSize="14"
                                         Padding="12,0,48,0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed" />
                                <Button x:Name="ToggleConfirmPasswordButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="40" Height="40"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        Click="ToggleConfirmPasswordButton_Click"
                                        ToolTip="Mostrar/ocultar senha">
                                    <TextBlock x:Name="ConfirmEyeIcon" Text="👁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <TextBlock Text="As senhas não coincidem"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasConfirmPasswordError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=empty}" />

                        <!-- Register Button -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Cadastrar"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Height="48"
                                FontSize="14"
                                FontWeight="Medium"
                                Margin="0,0,0,10" />

                        <!-- Loading Indicator -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,14">
                            <Border Width="20" Height="20" BorderBrush="White" BorderThickness="2" CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotation" Angle="0" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1"
                                                                 RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <TextBlock Text="Cadastrando..." Style="{StaticResource BodyStyle}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>

                        <!-- Login Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Já tem conta? " Style="{StaticResource BodyStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                            <Button Content="Entrar" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2" BorderThickness="0" Background="Transparent" FontSize="13"
                                    Command="{Binding GoToLoginCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Version/Footer -->
                <TextBlock Grid.Row="2" Text="v1.0.0"
                           Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="10" />
            </Grid>
        </Border>
    </Grid>
</UserControl>