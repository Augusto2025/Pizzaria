<Window x:Class="PizzariaDesktop.Views.Orders.OrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzariaDesktop.Views.Orders"
        xmlns:models="clr-namespace:PizzariaDesktop.Models"
        xmlns:converters="clr-namespace:PizzariaDesktop.Converters"
        mc:Ignorable="d"
        Title="Detalhes do Pedido"
        Height="750" Width="500"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Colors -->
        <Color x:Key="PrimaryColor">#FF6B35</Color>
        <Color x:Key="PrimaryVariantColor">#E85D2E</Color>
        <Color x:Key="SuccessColor">#28A745</Color>
        <Color x:Key="SuccessLightColor">#E8F5E9</Color>
        <Color x:Key="WarningColor">#FFC107</Color>
        <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="SurfaceColor">#FFF8F9FA</Color>
        <Color x:Key="TextPrimaryColor">#FF1A1A2E</Color>
        <Color x:Key="TextSecondaryColor">#FF6C757D</Color>
        <Color x:Key="BorderColor">#FFE9ECEF</Color>
        <Color x:Key="DividerColor">#FFDEE2E6</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

        <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>

        <!-- Typography Styles -->
        <Style x:Key="DisplayStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="36" />
        </Style>

        <Style x:Key="HeadlineStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="BadgeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryVariantBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D44E1F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FFA890" />
                                <Setter Property="Foreground" Value="#FFE0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="28,14" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFF0EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFE0D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceColor}" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Effects -->
        <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" ShadowDepth="0" BlurRadius="24" Opacity="0.12" />

        <!-- Converters -->
        <converters:OrderStatusToColorConverter x:Key="OrderStatusToColorConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:CategoryToIconConverter x:Key="CategoryToIconConverter" />
    </Window.Resources>

    <Grid>
        <!-- Main Card with Shadow -->
        <Border Background="Transparent" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource CardShadowEffect}">
            <Border CornerRadius="20" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Header -->
                        <RowDefinition Height="*" />     <!-- Scrollable Content -->
                        <RowDefinition Height="Auto" />  <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- ==================== HEADER ==================== -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,28" CornerRadius="19,19,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📦 Detalhes do Pedido" Style="{StaticResource HeadlineStyle}" Foreground="White" FontSize="22" />
                                <TextBlock x:Name="OrderIdText" Text="Pedido #ABC123XY" Style="{StaticResource SubtitleStyle}" Foreground="#FFFFE0D8" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="✕" FontSize="18" FontWeight="Bold"
                                    Width="40" Height="40" Padding="0" Click="CloseButton_Click" ToolTip="Fechar" />
                        </Grid>
                    </Border>

                    <!-- ==================== SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24"
                                  BorderThickness="0" Background="Transparent">
                        <StackPanel x:Name="ContentStack" Orientation="Vertical">

                            <!-- Status Badge -->
                            <Border x:Name="StatusBadge" Background="{StaticResource SuccessBrush}" CornerRadius="20"
                                    Padding="16,10" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <TextBlock x:Name="StatusText" Text="Confirmado" FontSize="13" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <!-- PAGO Badge (for paid orders) -->
                            <Border x:Name="PaidBadge" Background="#FF28A745" CornerRadius="20" Padding="16,10"
                                    HorizontalAlignment="Left" Margin="0,0,0,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="PAGO" Style="{StaticResource BadgeStyle}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Order Info Card -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,20" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                                Background="#FFFFF0EB">
                                            <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="OrderIdDetailText" Text="Pedido #ABC123XY" Style="{StaticResource TitleStyle}" FontSize="18" />
                                            <TextBlock x:Name="OrderDateText" Text="24/11/2024 20:15" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Payment Method -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                Background="#FFF3E5F5">
                                            <TextBlock Text="💳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="Forma de Pagamento" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="PaymentMethodText" Text="PIX" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="15" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Delivery Address -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                Background="#FFE8F5E9">
                                            <TextBlock Text="📍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="Endereço de Entrega" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock x:Name="DeliveryAddressText" Text="Rua das Flores, 123 - Jardim Primavera, São Paulo/SP"
                                                       Style="{StaticResource BodyStyle}" FontWeight="Medium" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Delivery Time Estimate (Prominent) -->
                            <Border x:Name="DeliveryTimeCard" Background="{StaticResource SuccessLightBrush}"
                                    BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2"
                                    CornerRadius="16" Padding="24" Margin="0,0,0,20" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="⏱" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Previsão de Entrega" Style="{StaticResource TitleStyle}" FontSize="15"
                                                   Foreground="#FF2E7D32" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock x:Name="DeliveryTimeText" Text="20:45" Style="{StaticResource DisplayStyle}"
                                               FontSize="32" Foreground="#FF1B5E20" TextAlignment="Center" FontWeight="Bold"
                                               LineHeight="40" />

                                    <TextBlock x:Name="DeliveryWindowText" Text="entre 20:35 - 21:05" Style="{StaticResource BodyStyle}"
                                               FontSize="14" Foreground="#FF2E7D32" TextAlignment="Center" Margin="0,6,0,0"
                                               FontWeight="Medium" />

                                    <TextBlock Text="Entregamos quentinho na sua casa! 🍕" Style="{StaticResource CaptionStyle}"
                                               Foreground="#FF4CAF50" TextAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Timeline -->
                            <TextBlock Text="📋 Linha do Tempo" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="TimelineControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,10,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="{Binding Status, Converter={StaticResource OrderStatusToColorConverter}}"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="📍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusDisplayName}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                               Visibility="{Binding Note, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,20,0,20" />

                            <!-- Items -->
                            <TextBlock Text="🍕 Itens do Pedido" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="ItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,10,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Product, Converter={StaticResource CategoryToIconConverter}}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Product.Name}" Style="{StaticResource BodyStyle}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Quantity, StringFormat='Qtd: {0} • {1}'}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedTotalPrice}" Style="{StaticResource BodyStyle}" FontWeight="Medium" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Notes -->
                            <Border x:Name="NotesCard" Background="#FFFFF8E1" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📝" FontSize="18" VerticalAlignment="Top" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Observações" Style="{StaticResource CaptionStyle}" FontWeight="Medium" Foreground="#FF856D00" Margin="0,0,0,4" />
                                        <TextBlock x:Name="NotesText" Text="" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Foreground="#FF856D00" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,20,0,20" />

                            <!-- Totals -->
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource BodyStyle}" FontSize="15" />
                                    <TextBlock Grid.Column="1" x:Name="SubtotalText" Text="R$ 82,70" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="15" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Taxa de Entrega" Style="{StaticResource BodyStyle}" FontSize="15" />
                                    <TextBlock Grid.Column="1" x:Name="DeliveryFeeText" Text="R$ 5,00" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="15" />
                                </Grid>

                                <Border Height="1.5" Background="{StaticResource DividerBrush}" Margin="0,10,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource TitleStyle}" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="TotalText" Text="R$ 87,70" Style="{StaticResource TitleStyle}" FontSize="22" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== ACTION BUTTONS ==================== -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20,16,20,24" CornerRadius="0,0,19,19"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Vertical">
                            <!-- Primary Action: Reorder -->
                            <Button x:Name="ReorderButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="52" Click="ReorderButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Pedir Novamente" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary Action: Close -->
                            <Button x:Name="CloseButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="48" Margin="0,12,0,0" Click="CloseButton_Click">
                                <TextBlock Text="Fechar" VerticalAlignment="Center" FontWeight="Medium" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>