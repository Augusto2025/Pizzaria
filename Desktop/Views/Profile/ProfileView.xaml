<UserControl x:Class="PizzariaDesktop.Views.Profile.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PizzariaDesktop.Views.Profile"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Profile Header -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadlineStyle}" FontSize="24" />
                        <TextBlock Text="{Binding Email}" Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Phone}" Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Editar Perfil" Padding="16,8" Command="{Binding EditProfileCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Stats Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalOrders}" Style="{StaticResource HeadlineStyle}" FontSize="32" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Total de Pedidos" Style="{StaticResource SubtitleStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DeliveredOrders}" Style="{StaticResource HeadlineStyle}" FontSize="32" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Entregues" Style="{StaticResource SubtitleStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding FormattedTotalSpent}" Style="{StaticResource HeadlineStyle}" FontSize="32" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Total Gasto" Style="{StaticResource SubtitleStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Ações Rápidas" Style="{StaticResource TitleStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="🍕 Fazer Pedido" Padding="16,12" Margin="0,0,8,0" Command="{Binding GoToMenuCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="📦 Meus Pedidos" Padding="16,12" Margin="8,0,0,0" Command="{Binding GoToOrdersCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Saved Addresses -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📍 Endereços Salvos" Style="{StaticResource TitleStyle}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Gerenciar" Padding="16,8" Command="{Binding ManageAddressesCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Addresses}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding FullAddress}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="3" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Padrão" FontSize="9" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="▶" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Settings Options -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="⚙️ Configurações" Style="{StaticResource TitleStyle}" Margin="0,0,0,16" />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💳" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Formas de Pagamento" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                <TextBlock Text="Gerencie seus cartões e carteira digital" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Gerenciar" Padding="12,6" FontSize="12" Command="{Binding ManagePaymentMethodsCommand}" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔔" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Notificações" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                <TextBlock Text="Configure alertas de pedidos e promoções" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Configurar" Padding="12,6" FontSize="12" Command="{Binding SettingsCommand}" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎨" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Tema" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                <TextBlock Text="Claro / Escuro / Sistema" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Alterar" Padding="12,6" FontSize="12" Command="{Binding SettingsCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Logout -->
            <Border Style="{StaticResource CardStyle}" Padding="20" BorderBrush="#FFDC3545" BorderThickness="1">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="🚪 Sair da Conta"
                        Padding="24,12"
                        HorizontalAlignment="Stretch"
                        Foreground="#FFDC3545" BorderBrush="#FFDC3545"
                        Command="{Binding LogoutCommand}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>