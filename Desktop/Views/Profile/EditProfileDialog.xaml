<Window x:Class="PizzariaDesktop.Views.Profile.EditProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzariaDesktop.Views.Profile"
        mc:Ignorable="d"
        Title="Editar Perfil"
        Height="520" Width="460"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Colors -->
        <Color x:Key="PrimaryColor">#FF6B35</Color>
        <Color x:Key="PrimaryVariantColor">#E85D2E</Color>
        <Color x:Key="SuccessColor">#28A745</Color>
        <Color x:Key="ErrorColor">#DC3545</Color>
        <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="SurfaceColor">#FFF8F9FA</Color>
        <Color x:Key="TextPrimaryColor">#FF1A1A2E</Color>
        <Color x:Key="TextSecondaryColor">#FF6C757D</Color>
        <Color x:Key="BorderColor">#FFE9ECEF</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>

        <!-- Typography Styles -->
        <Style x:Key="HeadlineStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryVariantBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D44E1F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FFA890" />
                                <Setter Property="Foreground" Value="#FFE0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="28,14" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFF0EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFE0D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceColor}" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Effects -->
        <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" ShadowDepth="0" BlurRadius="24" Opacity="0.12" />

        <!-- Input Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Card with Shadow -->
        <Border Background="Transparent" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource CardShadowEffect}">
            <Border CornerRadius="20" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Header -->
                        <RowDefinition Height="*" />     <!-- Content -->
                        <RowDefinition Height="Auto" />  <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- ==================== HEADER ==================== -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,28" CornerRadius="19,19,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="✏️ Editar Perfil" Style="{StaticResource HeadlineStyle}" Foreground="White" FontSize="22" />
                                <TextBlock Text="Atualize suas informações pessoais" Style="{StaticResource SubtitleStyle}" Foreground="#FFFFE0D8" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="✕" FontSize="18" FontWeight="Bold"
                                    Width="40" Height="40" Padding="0" Click="CloseButton_Click" ToolTip="Fechar" />
                        </Grid>
                    </Border>

                    <!-- ==================== CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24"
                                  BorderThickness="0" Background="Transparent">
                        <StackPanel Orientation="Vertical">

                            <!-- Profile Photo (Display only) -->
                            <Border Width="100" Height="100" CornerRadius="50" Background="{StaticResource PrimaryBrush}" Margin="0,0,0,24" HorizontalAlignment="Center">
                                <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Name Field -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Nome Completo" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" />
                                <TextBox x:Name="NameTextBox" Style="{StaticResource InputStyle}" Height="48" />
                            </StackPanel>

                            <!-- Email Field (Read-only display) -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="E-mail" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" />
                                <TextBox x:Name="EmailTextBox" Style="{StaticResource InputStyle}" Height="48" IsReadOnly="True" Background="{StaticResource SurfaceBrush}" />
                                <TextBlock Text="O e-mail não pode ser alterado" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Phone Field -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Telefone" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" />
                                <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputStyle}" Height="48" />
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,16,0,16" />

                            <!-- Change Password Section -->
                            <TextBlock Text="🔒 Alterar Senha" Style="{StaticResource HeadlineStyle}" FontSize="18" Margin="0,0,0,16" />

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Senha Atual" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" />
                                <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource PasswordBoxStyle}" Height="48" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Nova Senha" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" />
                                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordBoxStyle}" Height="48" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Confirmar Nova Senha" Style="{StaticResource BodyStyle}" FontWeight="Medium" Margin="0,0,0,6" />
                                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordBoxStyle}" Height="48" />
                            </StackPanel>

                            <!-- Error/Success Message -->
                            <Border x:Name="MessageBorder" Background="#FFE8F5E9" BorderBrush="#FF4CAF50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="MessageText" Text="" Style="{StaticResource BodyStyle}" FontSize="13" Foreground="#FF2E7D32" TextWrapping="Wrap" />
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== ACTION BUTTONS ==================== -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20,16,20,24" CornerRadius="0,0,19,19"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Vertical">
                            <!-- Save Button -->
                            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="52" Click="SaveButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Salvar Alterações" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Cancel Button -->
                            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="48" Margin="0,12,0,0" Click="CloseButton_Click">
                                <TextBlock Text="Cancelar" VerticalAlignment="Center" FontWeight="Medium" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>