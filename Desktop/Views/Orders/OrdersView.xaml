<UserControl x:Class="PizzariaDesktop.Views.Orders.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PizzariaDesktop.Views.Orders"
             xmlns:models="clr-namespace:PizzariaDesktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Orders List -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="24,24,12,24" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📦 Meus Pedidos" Style="{StaticResource HeadlineStyle}" FontSize="24" Foreground="White" />
                            <TextBlock Text="Acompanhe o status dos seus pedidos" Style="{StaticResource SubtitleStyle}" Foreground="#FFFFE0D8" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Orders List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                    <ItemsControl ItemsSource="{Binding Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Background="{Binding IsSelected, Converter={StaticResource BoolToBackgroundConverter}, ConverterParameter=selected}"
                                        Padding="20" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Indicator -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                                Background="{Binding Status, Converter={StaticResource OrderStatusToColorConverter}}"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Order Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ShortId, StringFormat='Pedido #{0}'}" Style="{StaticResource TitleStyle}" FontSize="16" />
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedCreatedAt}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="16,0,0,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedTotal}" Style="{StaticResource TitleStyle}" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="16,0,0,0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StatusDisplayName}" Style="{StaticResource BodyStyle}" FontWeight="Medium"
                                                           Foreground="{Binding Status, Converter={StaticResource OrderStatusToColorConverter}}" />
                                                <TextBlock Text=" • " Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} item(ns)'}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Arrow -->
                                        <TextBlock Grid.Column="2" Text="▶" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40"
                        Visibility="{Binding Orders.Count, Converter={StaticResource EmptyToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📦" FontSize="64" />
                        <TextBlock Text="Nenhum pedido ainda" Style="{StaticResource TitleStyle}" Margin="0,16,0,8" />
                        <TextBlock Text="Faça seu primeiro pedido no cardápio" Style="{StaticResource SubtitleStyle}" TextAlignment="Center" MaxWidth="300" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Ir ao Cardápio" Padding="24,12" Margin="0,24,0,0"
                                Command="{Binding GoToMenuCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Order Detail (Sidebar) -->
        <Border Grid.Column="1" Width="400" Style="{StaticResource CardStyle}" Margin="12,24,24,24" Padding="0"
                Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detalhes do Pedido" Style="{StaticResource TitleStyle}" Foreground="White" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="✕" FontSize="16" FontWeight="Bold"
                                Command="{Binding ClearSelectionCommand}" ToolTip="Fechar" />
                    </Grid>
                </Border>

                <!-- Detail Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                    <ContentControl Content="{Binding SelectedOrder}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Order Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                                                Background="{Binding Status, Converter={StaticResource OrderStatusToColorConverter}}">
                                            <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding ShortId, StringFormat='Pedido #{0}'}" Style="{StaticResource TitleStyle}" FontSize="18" />
                                            <TextBlock Text="{Binding FormattedCreatedAt}" Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Status Badge -->
                                    <Border Background="{Binding Status, Converter={StaticResource OrderStatusToColorConverter}}"
                                            CornerRadius="20" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,20">
                                        <TextBlock Text="{Binding StatusDisplayName}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                    </Border>

                                    <!-- Timeline -->
                                    <TextBlock Text="📋 Linha do Tempo" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding Timeline}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,8,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                                Background="{Binding Status, Converter={StaticResource OrderStatusToColorConverter}}"
                                                                Margin="0,0,12,0">
                                                            <TextBlock Text="📍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusDisplayName}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                                       Visibility="{Binding Note, Converter={StaticResource EmptyToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,20" />

                                    <!-- Items -->
                                    <TextBlock Text="🍕 Itens do Pedido" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,8,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Product, Converter={StaticResource CategoryToIconConverter}}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Product.Name}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                                            <TextBlock Text="{Binding Quantity, StringFormat='Qtd: {0} • {1}'}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTotalPrice}" Style="{StaticResource BodyStyle}" FontWeight="Medium" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,20" />

                                    <!-- Payment & Delivery Info -->
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="💳 Pagamento: " Style="{StaticResource BodyStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethod}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📍 Entregar em: " Style="{StaticResource BodyStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DeliveryAddress.FullAddress}" Style="{StaticResource BodyStyle}" FontWeight="Medium" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8" Visibility="{Binding Notes, Converter={StaticResource EmptyToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📝 Obs: " Style="{StaticResource BodyStyle}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Notes}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,20" />

                                    <!-- Totals -->
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource BodyStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSubtotal}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Taxa de Entrega" Style="{StaticResource BodyStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDeliveryFee}" Style="{StaticResource BodyStyle}" FontWeight="Medium" />
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource TitleStyle}" FontSize="18" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTotal}" Style="{StaticResource TitleStyle}" FontSize="18" Foreground="{StaticResource PrimaryBrush}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Reorder Button -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔄 Pedir Novamente" Padding="16,10" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.ReorderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Empty Detail State -->
        <Border Grid.Column="1" Width="400" Style="{StaticResource CardStyle}" Margin="12,24,24,24" Padding="40"
                Visibility="{Binding HasSelectedOrder, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📦" FontSize="64" />
                <TextBlock Text="Selecione um pedido" Style="{StaticResource TitleStyle}" Margin="0,16,0,8" />
                <TextBlock Text="Clique em um pedido na lista para ver os detalhes" Style="{StaticResource SubtitleStyle}" TextAlignment="Center" MaxWidth="300" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>