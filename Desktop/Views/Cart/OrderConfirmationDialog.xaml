<Window x:Class="PizzariaDesktop.Views.Cart.OrderConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzariaDesktop.Views.Cart"
        mc:Ignorable="d"
        Title="Pedido Confirmado"
        Height="620" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Colors - Using app's primary palette -->
        <Color x:Key="PrimaryColor">#FF6B35</Color>
        <Color x:Key="PrimaryVariantColor">#E85D2E</Color>
        <Color x:Key="SuccessColor">#28A745</Color>
        <Color x:Key="SuccessLightColor">#E8F5E9</Color>
        <Color x:Key="WarningColor">#FFC107</Color>
        <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="SurfaceColor">#FFF8F9FA</Color>
        <Color x:Key="TextPrimaryColor">#FF1A1A2E</Color>
        <Color x:Key="TextSecondaryColor">#FF6C757D</Color>
        <Color x:Key="BorderColor">#FFE9ECEF</Color>
        <Color x:Key="DividerColor">#FFDEE2E6</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

        <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>

        <!-- Typography Styles -->
        <Style x:Key="DisplayStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="40" />
        </Style>

        <Style x:Key="HeadlineStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="BadgeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Primary Button - Main Action -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                                Effect="{StaticResource ButtonShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryVariantBrush}" />
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource PrimaryColor}" ShadowDepth="0" BlurRadius="16" Opacity="0.4" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D44E1F" />
                                <Setter TargetName="Border" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FFA890" />
                                <Setter TargetName="Border" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button - Alternative Action -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="28,14" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFF0EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFE0D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD0C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button - Minimal Action -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceColor}" />
                                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BorderColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Effects -->
        <DropShadowEffect x:Key="ButtonShadowEffect" Color="{StaticResource PrimaryColor}" ShadowDepth="0" BlurRadius="12" Opacity="0.3" />
        <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" ShadowDepth="0" BlurRadius="24" Opacity="0.12" />

        <!-- Item Container Style -->
        <Style x:Key="OrderItemContainerStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Fade in + Scale animation for main card -->
                    <DoubleAnimation Storyboard.TargetName="MainCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"
                                     BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainCardTransform"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.92" To="1" Duration="0:0:0.45"
                                     BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainCardTransform"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.92" To="1" Duration="0:0:0.45"
                                     BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Success checkmark animation -->
                    <DoubleAnimation Storyboard.TargetName="SuccessCheckmark"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SuccessCheckmark"
                                     Storyboard.TargetProperty="RenderTransform.ScaleX"
                                     From="0" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SuccessCheckmark"
                                     Storyboard.TargetProperty="RenderTransform.ScaleY"
                                     From="0" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Pulse ring animation -->
                    <DoubleAnimation Storyboard.TargetName="PulseRing"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.5" To="0" Duration="0:0:1.5"
                                     BeginTime="0:0:0.4" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PulseRing"
                                     Storyboard.TargetProperty="RenderTransform.ScaleX"
                                     From="1" To="1.6" Duration="0:0:1.5"
                                     BeginTime="0:0:0.4" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PulseRing"
                                     Storyboard.TargetProperty="RenderTransform.ScaleY"
                                     From="1" To="1.6" Duration="0:0:1.5"
                                     BeginTime="0:0:0.4" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Content stagger animation -->
                    <DoubleAnimation Storyboard.TargetName="ContentStack"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4"
                                     BeginTime="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ContentStack"
                                     Storyboard.TargetProperty="RenderTransform.Children[0].Y"
                                     From="20" To="0" Duration="0:0:0.5"
                                     BeginTime="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Main Card with Shadow -->
        <Border x:Name="MainCard" Background="Transparent" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource CardShadowEffect}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="MainCardTransform" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <Border CornerRadius="20" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Success Header -->
                        <RowDefinition Height="*" />     <!-- Scrollable Content -->
                        <RowDefinition Height="Auto" />  <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- ==================== SUCCESS HEADER ==================== -->
                    <Border Grid.Row="0" Background="{StaticResource SuccessBrush}" Padding="32,36" CornerRadius="19,19,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Animated Success Circle with Pulse Ring -->
                            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <!-- Pulse Ring -->
                                <Border x:Name="PulseRing" Width="96" Height="96" CornerRadius="48"
                                        BorderBrush="White" BorderThickness="3" Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Success Checkmark Container -->
                                <Border x:Name="SuccessCheckmark" Width="96" Height="96" CornerRadius="48"
                                        Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0" ScaleY="0" />
                                    </Border.RenderTransform>
                                    <Viewbox Width="48" Height="48">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                                                  Fill="{StaticResource SuccessColor}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <!-- Main Success Message -->
                            <TextBlock Grid.Row="1" Text="✅ Pedido Confirmado e Pago!" Style="{StaticResource DisplayStyle}"
                                       Foreground="White" TextAlignment="Center" FontSize="26" LineHeight="34"
                                       TextWrapping="Wrap" MaxWidth="360" />

                            <!-- Subtitle with delivery time highlight -->
                            <TextBlock Grid.Row="2" x:Name="HeaderSubtitleText"
                                       Style="{StaticResource SubtitleStyle}" Foreground="#FFD4EDDA" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="360" Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- ==================== SCROLLABLE CONTENT ==================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,28"
                                  BorderThickness="0" Background="Transparent">
                        <StackPanel x:Name="ContentStack" Orientation="Vertical">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </StackPanel.RenderTransform>

                            <!-- Order Info Card -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,20" Effect="{StaticResource CardShadowEffect}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                            Background="#FFFFF0EB">
                                        <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock x:Name="OrderIdText" Text="Pedido #ABC123XY" Style="{StaticResource TitleStyle}" FontSize="20" />
                                        <TextBlock x:Name="OrderTimeText" Text="24/11/2024 20:15" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DELIVERY TIME CARD (PROMINENT) -->
                            <Border x:Name="DeliveryTimeCard" Background="{StaticResource SuccessLightBrush}"
                                    BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2"
                                    CornerRadius="16" Padding="28,24" Margin="0,0,0,20">
                                <Grid>
                                    <!-- Decorative icon background -->
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-12,0,0">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SuccessBrush}" Opacity="0.15" />
                                        <TextBlock Text="🚀" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0" />
                                    </Grid>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="⏱" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Previsão de Entrega" Style="{StaticResource TitleStyle}" FontSize="16"
                                                       Foreground="#FF2E7D32" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Main delivery time - BIG and PROMINENT -->
                                        <TextBlock x:Name="DeliveryTimeText" Text="20:45" Style="{StaticResource DisplayStyle}"
                                                   FontSize="36" Foreground="#FF1B5E20" TextAlignment="Center" FontWeight="Bold"
                                                   LineHeight="44" />

                                        <!-- Delivery window range -->
                                        <TextBlock x:Name="DeliveryWindowText" Text="entre 20:35 - 21:05" Style="{StaticResource BodyStyle}"
                                                   FontSize="15" Foreground="#FF2E7D32" TextAlignment="Center" Margin="0,6,0,8"
                                                   FontWeight="Medium" />

                                        <!-- Delivery Address -->
                                        <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,8,0,0"
                                                BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" Opacity="0.9">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="📍" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DeliveryAddressText"
                                                           Text="Rua das Flores, 123 - Jardim Primavera, São Paulo/SP"
                                                           Style="{StaticResource BodyStyle}" TextAlignment="Center"
                                                           Foreground="#FF1B5E20" TextWrapping="Wrap" MaxWidth="280"
                                                           FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- PAYMENT CONFIRMATION CARD -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,20"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadowEffect}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                            Background="#FFF3E5F5">
                                        <TextBlock Text="💳" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                                        <TextBlock Text="Forma de Pagamento" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock x:Name="PaymentMethodText" Text="PIX" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="16" />
                                    </StackPanel>

                                    <!-- PROMINENT PAID BADGE -->
                                    <Border Grid.Column="2" Background="{StaticResource SuccessBrush}" CornerRadius="20"
                                            Padding="16,10" VerticalAlignment="Center" Effect="{StaticResource CardShadowEffect}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="PAGO" Style="{StaticResource BadgeStyle}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ORDER ITEMS -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Itens do Pedido" Style="{StaticResource TitleStyle}" FontSize="17" />
                                <TextBlock Grid.Column="1" x:Name="ItemCountText" Text="3 itens" Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </Grid>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <ItemsControl x:Name="OrderItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OrderItemContainerStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Product Icon -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                            Background="{StaticResource BackgroundBrush}" Margin="0,0,14,0"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Product Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStyle}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionStyle}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Price -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Price}" Style="{StaticResource BodyStyle}" FontWeight="SemiBold"
                                                               FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- TOTALS CARD -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24" Margin="0,20,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource BodyStyle}" FontSize="15" />
                                        <TextBlock Grid.Column="1" x:Name="SubtotalText" Text="R$ 82,70" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="15" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Taxa de Entrega" Style="{StaticResource BodyStyle}" FontSize="15" />
                                        <TextBlock Grid.Column="1" x:Name="DeliveryFeeText" Text="R$ 5,00" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" FontSize="15" />
                                    </Grid>

                                    <Border Height="1.5" Background="{StaticResource DividerBrush}" Margin="0,10,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Total Pago" Style="{StaticResource TitleStyle}" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="TotalText" Text="R$ 87,70" Style="{StaticResource TitleStyle}" FontSize="22" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- HELPFUL TIP -->
                            <Border Background="#FFFFF8E1" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource WarningBrush}" Opacity="0.15">
                                        <TextBlock Text="💡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text='Acompanhe o status em tempo real na aba "Meus Pedidos"' Style="{StaticResource BodyStyle}" FontSize="13"
                                               Foreground="#FF856D00" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== ACTION BUTTONS ==================== -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="24,20,24,28" CornerRadius="0,0,19,19"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Vertical" Margin="0">
                            <!-- Primary Action: Track Order -->
                            <Button x:Name="TrackOrderButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="56" Click="TrackOrderButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Acompanhar Pedido" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary Action: New Order -->
                            <Button x:Name="NewOrderButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="52" Margin="0,12,0,0" Click="NewOrderButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Fazer Outro Pedido" VerticalAlignment="Center" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>